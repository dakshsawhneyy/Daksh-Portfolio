MONGODB_URI=mongodb+srv://...
PORT=4000

# ── "Ask about Daksh" agent (routes/agentRoute.js + agent/providers.js) ──
# Provider order: AGENT_PROVIDER if set, else Gemini (if key) → Claude (if key).
# If the first provider errors before answering, the next one is tried.
# With no key at all the endpoint returns 503 and the widget uses its
# offline knowledge base.

# Free tier: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # fast; thinking is disabled for 2.5-flash

# Optional paid fallback / alternative
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# AGENT_PROVIDER=gemini           # or: anthropic
# AGENT_PER_IP_LIMIT=25           # requests per IP per 15 min
# AGENT_DAILY_LIMIT=600           # total requests per day (stays well inside free quotas)
